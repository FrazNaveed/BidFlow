GEMINI_API_KEY=
# Optional: gemini-2.5-flash (default), gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Production only — your deployed app URL (no trailing slash), e.g. https://bidflow.vercel.app
NEXT_PUBLIC_SITE_URL=https://bidflow.vercel.app

# After setup, index the company library:
# Library → "Index company library"

# Auth setup (Supabase Dashboard):
# 1. Authentication → Providers → Google → enable
# 2. Authentication → URL Configuration:
#    Site URL: https://bidflow.vercel.app   (must NOT be localhost)
#    Redirect URLs:
#      https://bidflow.vercel.app/**
#      http://localhost:3000/**
# 3. Run supabase/auth-migration.sql in SQL Editor
# 4. On Vercel, set NEXT_PUBLIC_SITE_URL=https://bidflow.vercel.app then redeploy
